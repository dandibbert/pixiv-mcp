# IMPORTANT: a Pixiv OAuth refresh token, NOT an access token.
PIXIV_REFRESH_TOKEN=
# HTTP or SOCKS proxy to reach Pixiv (requests[socks] needed for SOCKS).
PIXIV_HTTPS_PROXY=
# Download folder; use an absolute path in production.
PIXIV_DOWNLOAD_DIR=./downloads
# Per-job safety cap; upper bound 1000.
PIXIV_MAX_BATCH=300
# Minimum seconds between Pixiv API requests within this process.
PIXIV_REQUEST_DELAY=0.5

# HTTP MCP security; required for --transport http, not used for stdio.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PIXIV_MCP_BEARER_TOKEN=
# Allow expected public DNS names and/or Tailscale IPs. Example: pixiv.example.com,100.101.102.103
# Loopback (127.0.0.1, localhost, [::1]) is always allowed.
PIXIV_MCP_ALLOWED_HOSTS=
# Optional browser Origin allowlist (no cross-origin CORS middleware in v0.3.1).
PIXIV_MCP_ALLOWED_ORIGINS=

# New in v0.3.2: Pixev request compatibility and diagnosis
# pixev: use Pixev-style Android App API identity and fresh X-Client-* headers.
# legacy: leave PixivPy3 request headers untouched (A/B diagnostic mode).
PIXIV_APP_API_PROFILE=pixev
PIXIV_ACCEPT_LANGUAGE=zh-CN
